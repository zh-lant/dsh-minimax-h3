{
  "name": "dsh-minimax-h3",
  "version": "1.3.0",
  "type": "module",
  "description": "MiniMax H3 image and video tools, a local balance ledger, and a MiniMax settings page for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zh-lant/dsh-minimax-h3.git"
  },
  "homepage": "https://github.com/zh-lant/dsh-minimax-h3#readme",
  "bugs": {
    "url": "https://github.com/zh-lant/dsh-minimax-h3/issues"
  },
  "author": "zh-lant",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "minimax",
    "image",
    "video"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-shell"
      ]
    }
  },
  "license": "MIT"
}
